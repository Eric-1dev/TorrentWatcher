{
  "ConnectionStrings": {
    "Default": "Data Source=torrentwatcher.db"
  },
  "Storage": {
    "TorrentsDirectory": "/data/torrents"
  },
  "Security": {
    "KeysDirectory": "/data/keys"
  },
  "Rutracker": {
    "Browser": {
      "ProfileDirectory": "/data/browser",
      "Headless": false,
      "SolveTimeoutSeconds": 90,
      "DisableSandbox": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
